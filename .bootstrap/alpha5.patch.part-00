@@ -156,6 +156,7 @@ def load_state(project_dir: Path) -> dict:
         "goal": None,
         "constraints": None,
         "attempts": {},
+        "recovery_attempts": {},
         "approvals": {},
         "execution_context": None,
         "blocked_reason": None,
@@ -183,6 +184,10 @@ def bump_attempt(state: dict, phase: str) -> int:
     state.setdefault("attempts", {})[phase] = current
     return current
 
+
+def bump_recovery_attempt(state: dict, phase: str) -> int:
+    current = int(state.setdefault("recovery_attempts", {}).get(phase, 0)) + 1
+    state["recovery_attempts"][phase] = current
+    return current
+
+
 def acquire_lock(project_dir: Path, blocking: bool = True):
     ensure_research_dir(project_dir)
     lock_path = project_dir / ".research" / "lock"
