diff --git a/tests/recovery_quota_test.sh b/tests/recovery_quota_test.sh
new file mode 100755
index 0000000..392c46a
--- /dev/null
+++ b/tests/recovery_quota_test.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+test_root="$(mktemp -d)"
+trap 'rm -rf "$test_root"' EXIT
+cp -a "$(cd "$(dirname "$0")/.." && pwd)" "$test_root/research-mode"
+cd "$test_root/research-mode"
+export PATH="$PWD/tests/bin:$PATH"
+export FAKE_EVIDENCE_CASE=local-source-malformed
+export FAKE_SKIP_PHASE_RESULT_ONCE=evidence
+
+python3 researchctl.py new recovery-quota-study --goal "preserve bounded repair after a transient primary failure"
+python3 researchctl.py run recovery-quota-study
+python3 researchctl.py audit recovery-quota-study
+
+python3 - <<'PY'
+import json
+from pathlib import Path
+p=Path("projects/recovery-quota-study")
+s=json.load(open(p/".research/state.json"))
+assert s["phase"] == "plan-approval" and s["status"] == "waiting_approval"
+assert s["attempts"] == 0 and s["recovery_attempts"] == 0
+events=[json.loads(line) for line in (p/".research/events.jsonl").read_text().splitlines()]
+failed=[e for e in events if e["event"] == "phase_failed" and e.get("phase") == "evidence"]
+assert [e["failure_class"] for e in failed] == ["missing_phase_result", "semantic_validation"]
+repairs=[e for e in events if e["event"] == "phase_repair_started" and e.get("phase") == "evidence"]
+assert len(repairs) == 1 and repairs[0]["recovery_attempt"] == 1
+assert any(e["event"] == "phase_repair_completed" and e.get("phase") == "evidence" for e in events)
+ledger=json.load(open(p/"research/evidence-ledger.json"))
+query=ledger["queries"][0]
+source=ledger["evidence"][0]["source"]
+assert source["url"] == f'local:{query["snapshot"]["path"]}'
+assert source["persistent_id"] == f'sha256:{query["snapshot"]["sha256"]}'
+invalid=list((p/".research/invalid/evidence").glob("*/failure.json"))
+assert len(invalid) == 2
+PY
+
+echo "recovery quota test: PASS"
