+def canonical_evidence_source_for_repair(data: dict[str, Any], entry: dict[str, Any], project: Path) -> Any:
+    """Canonicalize only a provably project-owned query snapshot source."""
+    source = entry.get("source")
+    if not isinstance(source, dict):
+        return source
+    normalized = json.loads(json.dumps(source))
+    url = source.get("url")
+    query_id = entry.get("retrieval_query_id")
+    queries = {
+        item.get("id"): item
+        for item in data.get("queries", [])
+        if isinstance(item, dict) and isinstance(item.get("id"), str)
+    }
+    query = queries.get(query_id)
+    snapshot = query.get("snapshot") if isinstance(query, dict) else None
+    if not isinstance(snapshot, dict) or set(snapshot) != {"path", "sha256"}:
+        return normalized
+    snapshot_rel = snapshot.get("path")
+    snapshot_sha = snapshot.get("sha256")
+    if not isinstance(snapshot_rel, str) or not isinstance(snapshot_sha, str):
+        return normalized
+    try:
+        snapshot_path = safe_project_file(project, snapshot_rel, prefix="research/evidence/snapshots/")
+    except (OSError, ValueError, TypeError):
+        return normalized
+    if file_sha256(snapshot_path) != snapshot_sha:
+        return normalized
+    expected_local = f"local:{snapshot_rel}"
+    if isinstance(url, str) and url.startswith("file://"):
+        parsed = urlparse(url)
+        if parsed.scheme != "file" or parsed.netloc not in {"", "localhost"}:
+            return normalized
+        try:
+            file_path = Path(unquote(parsed.path)).resolve()
+            if file_path != snapshot_path.resolve():
+                return normalized
+        except (OSError, ValueError):
+            return normalized
+        normalized["url"] = expected_local
+        if not isinstance(normalized.get("persistent_id"), str) or not normalized["persistent_id"].strip():
+            normalized["persistent_id"] = f"sha256:{snapshot_sha}"
+    elif url == expected_local and (not isinstance(normalized.get("persistent_id"), str) or not normalized["persistent_id"].strip()):
+        normalized["persistent_id"] = f"sha256:{snapshot_sha}"
+    return normalized
+
+
