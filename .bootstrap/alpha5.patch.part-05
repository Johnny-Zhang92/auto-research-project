diff --git a/tests/evidence_repair_test.sh b/tests/evidence_repair_test.sh
index c36af2a..b8579c1 100755
--- a/tests/evidence_repair_test.sh
+++ b/tests/evidence_repair_test.sh
@@ -104,3 +104,43 @@ assert not (p/"scripts/injected.py").exists()
 PY
 
 echo "evidence repair test: PASS"
+
+unset FAKE_REPAIR_MUTATION
+unset FAKE_REPAIR_BLOCKED
+export FAKE_EVIDENCE_CASE=local-source-malformed
+python3 researchctl.py new local-source-repair-study --goal "normalize project-owned local evidence source"
+python3 researchctl.py run local-source-repair-study
+python3 - <<'PY'
+import json
+from pathlib import Path
+p=Path("projects/local-source-repair-study")
+s=json.load(open(p/".research/state.json"))
+assert s["phase"] == "plan-approval" and s["status"] == "waiting_approval"
+ledger=json.load(open(p/"research/evidence-ledger.json"))
+query=ledger["queries"][0]
+source=ledger["evidence"][0]["source"]
+assert source["url"] == f'local:{query["snapshot"]["path"]}'
+assert source["persistent_id"] == f'sha256:{query["snapshot"]["sha256"]}'
+events=(p/".research/events.jsonl").read_text()
+assert events.count('"event": "phase_repair_started"') == 1
+assert events.count('"event": "phase_repair_completed"') == 1
+PY
+
+export FAKE_EVIDENCE_CASE=local-source-external
+python3 researchctl.py new local-source-external-study --goal "reject external file source normalization"
+if python3 researchctl.py run local-source-external-study; then
+  echo "expected external local-source repair to block" >&2
+  exit 1
+fi
+python3 - <<'PY'
+import json
+from pathlib import Path
+p=Path("projects/local-source-external-study")
+s=json.load(open(p/".research/state.json"))
+assert s["phase"] == "blocked" and "repair changed scientific content" in s["blocker"]
+ledger=json.load(open(p/"research/evidence-ledger.json"))
+assert ledger["evidence"][0]["source"]["url"] == "file:///tmp/not-project-owned.json"
+assert ledger["evidence"][0]["source"]["persistent_id"] is None
+PY
+
+echo "local evidence source repair tests: PASS"
