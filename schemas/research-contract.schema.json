{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-mode.local/schemas/0.4.0-alpha.4/research-contract.schema.json",
  "title": "Research contract 0.4.0-alpha.4",
  "type": "object",
  "required": ["schema_version", "research_question", "scope", "known_facts", "assumptions", "unknowns", "exclusions", "budget", "stop_conditions"],
  "properties": {
    "schema_version": {"const": "0.4.0-alpha.4"},
    "research_question": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "known_facts": {"type": "array", "minItems": 1},
    "assumptions": {"type": "array", "minItems": 1},
    "unknowns": {"type": "array", "minItems": 1},
    "exclusions": {"type": "array", "minItems": 1},
    "budget": {"type": "object"},
    "stop_conditions": {"type": "array", "minItems": 1}
  }
}
