{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-mode.local/schemas/0.4.0-alpha.4/experiment-plan.schema.json",
  "title": "Experiment plan 0.4.0-alpha.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_ids", "conditions", "tasks", "metrics", "repetitions", "design", "budget", "stop_conditions", "analysis"],
  "properties": {
    "schema_version": {"const": "0.4.0-alpha.4"},
    "hypothesis_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "conditions": {
      "type": "array", "minItems": 2,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "tasks": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["id", "category", "deterministic_grader", "hidden_tests"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "deterministic_grader": {"const": true},
          "hidden_tests": {"const": true}
        }
      }
    },
    "metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["name", "primary"],
        "properties": {"name": {"type": "string", "minLength": 1}, "primary": {"type": "boolean"}}
      }
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "design": {
      "type": "object", "additionalProperties": true,
      "required": ["unit_of_analysis", "replication_unit", "assignment", "randomization", "blocking", "seeds", "data_split", "leakage_controls"],
      "properties": {
        "unit_of_analysis": {"type": "string", "minLength": 1},
        "replication_unit": {"type": "string", "minLength": 1},
        "assignment": {"type": "string", "minLength": 1},
        "randomization": {"type": "string", "minLength": 1},
        "blocking": {"type": "string", "minLength": 1},
        "seeds": {"type": "array", "minItems": 1},
        "data_split": {"type": "string", "minLength": 1},
        "leakage_controls": {"type": "array", "minItems": 1}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": true,
      "required": ["max_cost_usd", "max_wall_seconds", "max_run_seconds", "max_retries", "max_sessions"],
      "properties": {
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "max_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_run_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "max_sessions": {"type": "integer", "minimum": 1}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "analysis": {
      "type": "object", "additionalProperties": true,
      "required": ["primary_metric", "multiplicity", "missing_data", "sensitivity"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "multiplicity": {"type": "string", "minLength": 1},
        "missing_data": {"type": "string", "minLength": 1},
        "sensitivity": {"type": "string", "minLength": 1}
      }
    }
  }
}
