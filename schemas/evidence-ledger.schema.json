{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-mode.local/schemas/0.4.0-alpha.4/evidence-ledger.schema.json",
  "title": "Replayable evidence ledger 0.4.0-alpha.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queries", "claims", "evidence", "unresolved"],
  "properties": {
    "schema_version": {"const": "0.4.0-alpha.4"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backend", "endpoint", "parameters", "executed_at", "result_count", "status", "snapshot"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "backend": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "executed_at": {"type": "string", "minLength": 1},
          "result_count": {"type": "integer", "minimum": 0},
          "status": {"enum": ["completed", "partial", "failed"]},
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^research/evidence/snapshots/"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim_ids", "source", "retrieval_query_id", "accessed_at", "stance", "verification_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "persistent_id", "title"],
            "properties": {
              "url": {"type": "string", "pattern": "^(https?://|local:)"},
              "persistent_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1}
            }
          },
          "retrieval_query_id": {"type": "string", "minLength": 1},
          "accessed_at": {"type": "string", "minLength": 1},
          "stance": {"enum": ["supports", "contradicts", "neutral", "mixed"]},
          "verification_status": {"enum": ["verified", "metadata-only", "unresolved", "blocked"]}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
