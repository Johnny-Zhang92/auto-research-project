{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-mode.local/schemas/0.4.0-alpha.4/formal-result.schema.json",
  "title": "Formal experiment result 0.4.0-alpha.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "outcome", "sessions_started", "sessions_completed", "cost_usd", "wall_seconds", "budget_exceeded", "trial_ids", "trial_statuses", "result_hashes", "result_files", "checkpoint_path"],
  "properties": {
    "schema_version": {"const": "0.4.0-alpha.4"},
    "execution_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["completed", "inconclusive", "blocked", "terminated"]},
    "sessions_started": {"type": "integer", "minimum": 0},
    "sessions_completed": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "wall_seconds": {"type": "number", "minimum": 0},
    "budget_exceeded": {"type": "boolean"},
    "trial_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "trial_statuses": {"type": "object"},
    "result_hashes": {"type": "object"},
    "result_files": {"type": "object"},
    "checkpoint_path": {"const": "runs/formal-experiment/executor-state.json"}
  }
}
