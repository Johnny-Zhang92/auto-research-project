{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-mode.local/schemas/0.4.0-alpha.4/execution-manifest.schema.json",
  "title": "Execution manifest 0.4.0-alpha.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "executor", "entrypoint", "trials", "estimated_sessions", "budget", "frozen_inputs", "environment"],
  "properties": {
    "schema_version": {"const": "0.4.0-alpha.4"},
    "execution_id": {"type": "string", "minLength": 1},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "max_parallel", "failure_policy"],
      "properties": {
        "type": {"const": "local"},
        "protocol_version": {"const": "1"},
        "max_parallel": {"const": 1},
        "failure_policy": {"enum": ["continue", "fail-fast"]}
      }
    },
    "entrypoint": {"const": ["python3", "scripts/execute-approved.py"]},
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "condition", "task_id", "seed", "parameters"],
        "properties": {
          "trial_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
          "condition": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "seed": {"type": "integer"},
          "parameters": {"type": "object"}
        }
      }
    },
    "estimated_sessions": {"type": "integer", "minimum": 1},
    "budget": {"type": "object"},
    "frozen_inputs": {"type": "array", "minItems": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "dependency_lock", "code_snapshot", "data_artifacts", "pass_env"],
      "properties": {
        "python": {"type": "object"},
        "dependency_lock": {"type": "object"},
        "code_snapshot": {"type": "array", "minItems": 1},
        "data_artifacts": {"type": "array"},
        "pass_env": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
